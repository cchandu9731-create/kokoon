# ══════════════════════════════════════════
# KOKOON — Environment Variables
# Copy this file to .env and fill in values
# ══════════════════════════════════════════

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kokoon?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# Cloudinary (v2)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin seed credentials
ADMIN_EMAIL=admin@kokoon.in
ADMIN_PASSWORD=kokoon2026

# Frontend URL (for CORS)
FRONTEND_URL=http://127.0.0.1:5500

# EmailJS
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ORDER=your_order_template_id
EMAILJS_TEMPLATE_TRACKING=your_tracking_template_id
